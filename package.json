{
  "name": "@stom66/dcl-ui-component-kit",
  "version": "0.1.13",
  "description": "DCL UI Component Kit — reusable Decentraland SDK7 UI components, layers, zones, and themes",
  "keywords": [
    "decentraland",
    "dcl",
    "ui",
    "sdk7",
    "react-ecs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stom66/dcl-ui-component-kit.git"
  },
  "bugs": {
    "url": "https://github.com/stom66/dcl-ui-component-kit/issues"
  },
  "homepage": "https://github.com/stom66/dcl-ui-component-kit#readme",
  "main": "src/ui-component-kit/index.tsx",
  "types": "src/ui-component-kit/index.tsx",
  "exports": {
    ".": {
      "types": "./src/ui-component-kit/index.tsx",
      "default": "./src/ui-component-kit/index.tsx"
    }
  },
  "files": [
    "src/ui-component-kit",
    "assets/images/ui-component-kit",
    "scripts/cli.js",
    "scripts/postinstall.js",
    "scripts/lib/assets.js",
    "scripts/lib/themeScaffold.js",
    "INSTALL.md"
  ],
  "bin": {
    "dcl-ui-component-kit": "scripts/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "postinstall": "node scripts/postinstall.js",
    "copy-assets": "node scripts/cli.js copy-assets",
    "init-theme": "node scripts/cli.js init-theme",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "bump:patch": "npm version patch",
    "bump:minor": "npm version minor",
    "bump:major": "npm version major"
  },
  "peerDependencies": {
    "@dcl/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@dcl/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dcl/asset-packs": "latest",
    "@dcl/js-runtime": "7.26.1-31707982174.commit-07a0182",
    "@dcl/sdk": "^7.26.1-31707982174.commit-07a0182"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
